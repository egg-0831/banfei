# ============================================================================
# 连小理 · 班费透明工作流 —— 本地服务配置
# ----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 .env，然后按需填写。
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# ⚠️ .env 里有密钥，不要提交到任何公开仓库，也不要截图发到群里。
# ============================================================================

# ---- 服务端口与监听 ----
# 监听 0.0.0.0 = 同一 WiFi 下的手机也能访问（这是"换设备能看到同一条"的实现方式，
# 数据仍然不出本地网络，符合项目"不发布到公网"的红线）。
PORT=3300
HOST=0.0.0.0

# ---- 后台管理口令 ----
# 生活委员在后台页输入这道口令才能写入账目。
# ⚠️ 这里必须留空或填自己的口令：代码不内置默认口令；留空启动时服务会生成一个随机口令并打印在控制台。
ADMIN_TOKEN=

# ---- 大模型（可选）----
# 不填也能跑：前后台会自动降级为「本地离线规则引擎」，断网也不会中断演示。
#
# 任意 OpenAI 兼容端点都可以，把 LLM_BASE_URL 换成对应厂商即可：
#   深度求索 DeepSeek   https://api.deepseek.com/v1          模型 deepseek-chat
#   阿里通义千问         https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   月之暗面 Kimi        https://api.moonshot.cn/v1          模型 moonshot-v1-8k
#   智谱 GLM            https://open.bigmodel.cn/api/paas/v4 模型 glm-4-flash
#   腾讯混元             https://api.hunyuan.cloud.tencent.com/v1  模型 hunyuan-turbos-latest
#   本地 Ollama         http://localhost:11434/v1            模型 qwen2.5:7b
#
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 单次请求超时（毫秒）。网络不稳时可以调小，让降级更快发生。
LLM_TIMEOUT_MS=45000
